#include <stdio.h>
#include <string.h>

int main() {
    char word[] = "yellow";
    char result[4]; // Для "low" + '\0'
    int start = 3;  // Начало подстроки
    int end = 6;    // Конец подстроки (не включая)

    int j = 0;
    for (int i = start; i < end; i++) {
        result[j] = word[i];
        j++;
    }
    result[j] = '\0'; // Завершаем строку

    printf("Результат: %s\n", result);

    return 0;
}
